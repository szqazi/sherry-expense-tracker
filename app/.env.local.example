# Copy this file to .env.local (gitignored) and fill in your own Supabase
# project's values to enable optional cloud sync / Google sign-in locally.
# Without this file, the app runs exactly as before: local-only, no Account
# section in Settings. See supabase/schema.sql and the setup notes for how
# to create the project these values come from.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
